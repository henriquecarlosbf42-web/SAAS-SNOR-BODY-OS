# SNOR FUNILARIA — variáveis de ambiente
#
# Nunca commitar um .env* com valor real (só este .env.example, com nomes
# e descrição). Nunca colocar SERVER_ONLY/SECRET em variável NEXT_PUBLIC_*.
# Ver SECURITY.md seção 3 e src/config/env.public.ts / env.server.ts.

# ============================================================
# PUBLIC — prefixo NEXT_PUBLIC_, vai pro bundle do client.
# Só o que é seguro qualquer usuário ver no DevTools.
# ============================================================

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
# Domínio do app (usado no link de confirmação de email / reset de senha)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ============================================================
# SERVER_ONLY — lido só em Server Actions/Route Handlers/Edge
# Functions. Nunca importado por Client Component.
# ============================================================

# Required for server-side AI replies; never use a NEXT_PUBLIC_ prefix.
OPENAI_API_KEY=
RESEND_API_KEY=
TWILIO_ACCOUNT_SID=
GOOGLE_CALENDAR_CLIENT_ID=

# ============================================================
# SECRET — mais sensível ainda que SERVER_ONLY: dá acesso
# privilegiado (bypassa RLS, assina webhook, gera token). Rotacionar
# imediatamente se vazar; nunca aparece em log.
# ============================================================

SUPABASE_SERVICE_ROLE_KEY=
TWILIO_AUTH_TOKEN=
GOOGLE_CALENDAR_CLIENT_SECRET=
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
