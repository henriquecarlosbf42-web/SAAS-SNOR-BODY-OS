# Storage (Cloudflare R2) — obter em dash.cloudflare.com
R2_ACCOUNT_ID=SUBSTITUA
R2_ACCESS_KEY_ID=SUBSTITUA
R2_SECRET_ACCESS_KEY=SUBSTITUA
R2_BUCKET_NAME=bodyquote-uploads
