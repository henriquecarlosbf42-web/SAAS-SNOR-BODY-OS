# Database
DATABASE_URL="postgresql://bodyquote_app:senha_dev@localhost:5432/bodyquote_dev"
DATABASE_DIRECT_URL="postgresql://bodyquote_app:senha_dev@localhost:5432/bodyquote_dev"

# Auth (Clerk) — obter em clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_SUBSTITUA
CLERK_SECRET_KEY=sk_test_SUBSTITUA
CLERK_WEBHOOK_SECRET=whsec_SUBSTITUA

# Stripe — obter em dashboard.stripe.com
STRIPE_SECRET_KEY=sk_test_SUBSTITUA
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_SUBSTITUA
STRIPE_WEBHOOK_SECRET=whsec_SUBSTITUA
STRIPE_STARTER_PRICE_ID=price_SUBSTITUA
STRIPE_GROWTH_PRICE_ID=price_SUBSTITUA
STRIPE_PRO_PRICE_ID=price_SUBSTITUA

# Email (Resend) — obter em resend.com
RESEND_API_KEY=re_SUBSTITUA
